function prompt_pwd_unique {
  local p=${PWD/#$HOME/\~}
  [[ $p == / || $p == '~' ]] && { print -P "$p"; return }

  local -a parts; parts=("${(@s:/:)p}")
  local root=
  if [[ $parts[1] == '' ]]; then
    root='/'          # absolute path: swallow the leading empty split element
    parts=("${parts[@]:1}")
  elif [[ $parts[1] == '~' ]]; then
    root='~/'
    parts=("${parts[@]:1}")
  fi

  local -a out
  local i seg prefix_path cand sibling ambiguous

  for (( i = 1; i <= $#parts; i++ )); do
    seg=${parts[i]}
    if (( i == 1 )) || (( i == $#parts )); then
      out+=($seg)
      continue
    fi
    prefix_path="${root}${(j:/:)parts[1,i-1]}"
    for (( l = 1; l <= $#seg; l++ )); do
      cand=${seg[1,l]}
      ambiguous=0
      for sibling in ${prefix_path}/${cand}*(N/D:t); do
        [[ $sibling == $seg ]] && continue
        ambiguous=1; break
      done
      (( ! ambiguous )) && { seg=$cand; break }
    done
    out+=($seg)
  done

  print -P "${root}${(j:/:)out}"
}


function prompt_elapsed { local var=$1
  local dt=$(( SECONDS - _prompt_elapsed_start ))
  (( dt < 10 )) && return  # && print -v 'psvar[2]' ''

  local ss=$(( dt % 60 ))
  local mm=$(( (dt /= 60) % 60 ))
  local hh=$(( (dt /= 60) % 24 ))
  local dd=$(( dt / 24 ))

  local color=3 t=${ss}s bell=''
  ((mm > 0)) && { color=1;  t=${mm}m$t; }
  ((hh > 0)) && { color=13; t=${hh}h$t; }
  ((dd > 0)) && { color=9;  t=${dd}d$t; }
  ((dt > 60)) && t+=$'%{\a%}'  # <:attention / urgent bell
  ((dt > 120)) && t+=' %F{235}(%F{4}%*%F{235}…)'  # start of cmd

  print "%B%F{240}>>> elapsed time: %F{$color}${t}%f%b %F{238}(%D{%H:%M:%S})%f"

  if ((dt > 90)) && (($+commands[notify-send])); then
    local pcmd="$(fc -l -n -1)"
    # WKRND: suppress long-running ncurses/etc. interactive commands
    if ! [[ $pcmd =~ ^(bash|nvim|ranger)\\b.* ]]; then
      notify-send --urgency=critical "ZSH" "$pcmd"
    fi
  fi
}

function prompt_submit_rewrite {
  _prompt_saved_prompt=$PROMPT
  _prompt_saved_rprompt=$RPROMPT; RPROMPT=''
  # PROMPT=$'\n'"%F{$_prompt_color}$%f cd %B%F{220}%d%f%b && "
  # PROMPT=$'\n'"%B[%F{220}%d%f]%b"$'\n'"%F{$_prompt_color}❯%f "
  PROMPT="%F{$_prompt_color}┌──%f %B%F{220}%d%f%b %F{238}[%D{%H:%M:%S}]%f
%F{$_prompt_color}└%(!.#.╼)%f "

  zle && zle .reset-prompt
}

function prompt_precmd {
  # restore full prompt unconditionally before doing anything else this cycle
  if [[ -n $_prompt_saved_prompt ]]; then
    PROMPT=$_prompt_saved_prompt; _prompt_saved_prompt=
    RPROMPT=$_prompt_saved_rprompt; _prompt_saved_rprompt=
  fi
  prompt_git_query

  # BAD: any statement before prompt will override "%?"
  #   ALT: local err=$(print -P '%?')
  # BAD: perscent-expansion isn't recursive in PROMPT (and it keeps ANSI as-is)
  #   ALT:WKRND: print immediately inof expanding by %(1V.%F{$color}╸%f%1v.)
  print -v 'psvar[1]' -nrP '%(1j.%F{9}⚙%j%f.)%(?.. %F{1}%?↵%f)$(prompt_elapsed)'
  [[ ${psvar[1]:+x} ]] && print -P "%F{$_prompt_color}╸%f${psvar[1]}"

  # HACK: don't append timer on empty <CR>
  _prompt_elapsed_start=$SECONDS
}

function prompt_preexec {
  _prompt_elapsed_start=$SECONDS
}

function prompt_setup {
  zsh-defer -c '
    autoload -Uz add-zle-hook-widget
    add-zle-hook-widget zle-line-finish prompt_submit_rewrite

    autoload -Uz add-zsh-hook
    add-zsh-hook preexec prompt_preexec
    add-zsh-hook precmd  prompt_precmd

    prompt_git_init
  '

  local color=1
  if [[ $debian_chroot ]]; then color=4
  elif [[ $SSH_CONNECTION ]]; then color=2
    if [[ $TMUX ]]; then color=4
    elif [[ $HOST =~ vbox ]]; then color=3
    fi
  elif [[ -z $TMUX ]]; then color=7
  elif [[ $RANGER_LEVEL ]]; then color=22
  elif [[ $MIUR_LEVEL ]]; then color=34  # 62
  fi
  _prompt_color=$color

  local nest=
  [[ ${debian_chroot:+x} ]] && nest+=C
  [[ ${MIUR_LEVEL:+x} ]] && nest+=M
  [[ ${RANGER_LEVEL:+x} ]] && nest+=R
  [[ ${VIM:+x} ]] && nest+=V
  [[ ${NVIM:+x} ]] && nest+=V
  ## DISABLED: we have (.venv) aft path *and* it breaks fallback "${nest:-─}"
  ## FIXED: should affect prompt even after it was initially assigned
  # nest+="\${VIRTUAL_ENV:+E}"  # [[ ${VIRTUAL_ENV:+x} ]] && nest+=E

  # local parts
  # [[ $UID -eq 0 ]] && parts="╔═╚╣╼┇" || parts="┌─└╢╼┇"
  # OR: ╭ ╰

  # COS: to expand .venv path in prompt
  #   ALSO:WKRND: for $(prompt_elapsed) to not interfere with '%?'
  set -o promptsubst

  ## FIXED: disable prompt prefix from <any>/.venv/bin/activate
  VIRTUAL_ENV_DISABLE_PROMPT=1
  # DISABLED:(%~): I mostly don't pay attention to alias hints
  #   BUT I'm irritated when whole dir path is uselessly repeated
  # local info=" %F{238}\${\${VIRTUAL_ENV+%B(\$VIRTUAL_ENV)%b}:-%~}%f"
  local info=" \${_prompt_git_info}%F{238}\${VIRTUAL_ENV+ %B(\$VIRTUAL_ENV)%b}%f"

  if [[ $HOST =~ (MINIPC|VD600) ]]; then
    ## NOTE:(disable blinking cursor on WSL2/NUC):
    info+="%{"$'\e[2 q'"%}"
  fi

  [[ -n $nest ]] && nest="%F{60}%B$nest%b%F{$color}" || nest="─"
  # FAIL: "%(1V.%F{$color}╸%f%1v.)" prints ANSI escape-sequences literally
  #   ALT:WTF: "${psvar[1]:+%F{$color}╸%f${psvar[1]}}" prints only "}"
  # PROMPT="%F{$color}┌${nest:-─}%F{$color}─%f %B%F{220}\$(prompt_pwd_unique)%f%b${info}
  PROMPT="%F{$color}┌${nest}─%f %B%F{220}%d%f%b${info}
%F{$color}└\${_prompt_git_chars}%F{$color}%(!.#.╼)%f "

  # HACK: pre-print prompt on startup to reduce visual delay
  # NEED:(zshrc/end): print -rn -- $'\e[2F'  # CUP-style: cursor to start of line N-up
  # print -P -- "$PROMPT"

  ## FAIL: cursor would still jump around before actual prompt
  #   HACK: save and restore cursor position before printing static content
  # print -n $'\e[s'"$PROMPT"$'\e[u'$'\e[J'
}
