# IDEA:CHECK: if it works
#   Caveat: this toggles for the next completion invocation, not mid-menu
#     -- no live re-sort of an already-open completion list at the zsh level
toggle-comp-sort() {
  local cur=$(zstyle -L ':completion:*' sort)
  if [[ -z "$cur" ]]; then
    zstyle ':completion:*' sort false
  else
    zstyle -d ':completion:*' sort
  fi
}
zle -N toggle-comp-sort
bindkey '^X^S' toggle-comp-sort


