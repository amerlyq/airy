_forgit=/d/plugins/zsh/forgit/bin/git-forgit
alias gaj="$_forgit add"
alias gbj="$_forgit switch_branch"
alias gdj="$_forgit diff"
alias glj="$_forgit log"
alias grj="$_forgit rebase"
alias gsj="$_forgit show"
alias gvj="$_forgit blame"
alias gxj="$_forgit clean"
unset _forgit
