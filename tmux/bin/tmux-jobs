#!/usr/bin/env bash
#%SUMMARY: generic tmux-based parallel executor (knows nothing about the jobs it runs)
#%USAGE:
#     [cmd-mode]: $ printf 'cmd1\0cmd2\0' | tmux-jobs -j4
#   [xargs-mode]: $ printf 'a.mp4\0b.mp4\0' | tmux-jobs -j4 -- vcvt -c30 -g
#      [control]: $ tmux-jobs -k -s vcvt   # switch a running session to unattended-on-failure
#                 $ tmux-jobs -K -s vcvt   # switch back to stop-on-error (blocks new+existing failures)
#      [cleanup]: $ tmux kill-session -t vcvt
#%SPEC:
#   cmd-mode (default, no trailing argv after options):
#     stdin = \0-separated full shell command STRINGS.
#     Each run as `bash -xec "$cmd"` in its own pane.
#
#   xargs-mode (trailing `-- prog [fixed-args...]` given):
#     stdin = \0-separated ARGS (e.g. file paths), one job per arg.
#     Each run as `execv prog fixed-args... arg` in its own pane --
#     no shell, no quoting/escaping layer, arg passed through verbatim.
#
#   On nonzero exit: pane contents captured to ./<n>_err_<pid>.log,
#     printed and pane held open until ENTER.
#
# SEE/SEIZE: pane-focus from :/tmux/ctl/{parallel,job}

set -o errexit -o errtrace -o functrace -o noclobber -o nounset -o pipefail
shopt -qs inherit_errexit lastpipe
PS4='+[$BASHPID] ${BASH_SOURCE[0]##*/}:$LINENO:  '

# DEBUG:
# exec &> /tmp/tmux-jobs.$$

njobs=4
dry_run=0
keepgoing=0
session='jobs'
queue=
worker=0

# FIXME? merge with case-esac getops parsing of "-:" opts
# --worker is an internal re-exec marker (see `tmux new-session -d ... "$script" ... --worker`
#   below), not a public getopts flag -- must be stripped before getopts sees argv, and may
#   appear either as $1 (first re-exec) or after options (if ever passed positionally). One
#   pre-pass strips it wherever found; single-check `getopts` loop handles everything else.
_args=()
for a in "$@"; do
  if [[ $a == --worker && $worker -eq 0 ]]; then worker=1; else _args+=("$a"); fi
done
set -- "${_args[@]}"; unset _args a

while getopts 'j:nkKs:Q:x' o; do
case $o in :|'?') exit 2
;; j) njobs=$OPTARG
;; n) dry_run=1
;; k) keepgoing=1
;; K) keepgoing=0
;; s) session=$OPTARG
;; Q) queue=$OPTARG
;; x) set -x
esac; done; shift $((OPTIND-1))

: "${queue:=${XDG_CACHE_HOME:-$HOME/.cache}/tmux/${session}.txt}"

prog=("$@")  # Remaining argv (if any) is `prog [fixed-args...]` for xargs-mode.

lock=${queue}.lock
queue_dir=${queue%/*}
[[ $queue_dir == "$queue" ]] && queue_dir=.
mkdir -p "$queue_dir"
notify_lock=/tmp/tmux-jobs.${session}.$$.failed
status_dir=${TMPDIR:-/tmp}/tmux-jobs.${session}.$$
mkdir -p "$status_dir"
# Live attention-mode toggle: a plain `tmux-jobs -k/-K -s SESSION` (no stdin, no queue-op --
#   see ctl-command handling below) flips this file, which _wrap polls WHILE BLOCKED on an
#   already-failed pane's "press ENTER" prompt, not just at worker startup. Session-keyed
#   (not $$-keyed) so a control invocation and the long-running worker agree on the same path.
keepgoing_file=${queue}.keepgoing

# Exported because `tmux split-window`/`new-window` fork+exec bash as a direct child of the
#   tmux SERVER, which inherited this process's environment at `tmux new-session` time (first
#   launch only -- see below); panes are not login/interactive shells re-reading rc files, so
#   this is the only way they see these paths. (Resolved FAIL: exporting is required, not dead
#   weight -- confirmed against tmux's fork/exec model, not a config-reload path.)
export notify_lock status_dir keepgoing_file

success_log=${queue}.success.log
failure_log=${queue}.failure.log
inflight=${queue}.inflight

_queue_append() {
  local record="$1" fd added_ts
  added_ts=$(date +%s)  # date -Ins
  exec {fd}>>"$lock"
  flock -x "$fd"
  printf '%s %s\n' "$added_ts" "$record" >> "$queue"
  flock -u "$fd"
  exec {fd}>&-
}

# Atomically claims the queue's head record: reads it, pops it off $queue, and records it in
#   $inflight (so a worker crash between claim and completion doesn't lose the job -- see
#   crash-recovery replay at worker startup below). Sets the caller-visible `record` var.
#   (Resolved stale TODO: this already claims strictly by position under a single flock,
#   so there's no separate "remove by identity" step that could race or mismatch.)
_queue_take_first() {
  local fd tmp
  record=
  exec {fd}>>"$lock"
  flock -x "$fd"
  IFS= read -r record < "$queue" || record=
  if [[ -n $record ]]; then
    tmp=$(mktemp "${queue}.XXXXXX")
    tail -n +2 -- "$queue" >| "$tmp"
    mv -f -- "$tmp" "$queue"
    printf '%s\n' "$record" >> "$inflight"
  fi
  flock -u "$fd"
  exec {fd}>&-
}

_inflight_remove() {
  # BUG(fixed): `awk '$0 != target'` drops EVERY matching line, not just one.
  #   Two identical records in-flight at once (same file+flags enqueued
  #   twice) would both lose their crash-recovery entry the moment either
  #   job finished, silently dropping the other on a worker crash. Track
  #   whether we've already dropped one match and pass every line through
  #   unchanged after that.
  local record="$1" fd tmp
  tmp=$(mktemp "${inflight}.XXXXXX")
  exec {fd}>>"$lock"
  flock -x "$fd"
  awk -v target="$record" 'BEGIN{done=0} !done && $0==target{done=1;next} {print}' "$inflight" >| "$tmp"
  mv -f -- "$tmp" "$inflight"
  flock -u "$fd"
  exec {fd}>&-
}

_queue_requeue() {
  local record="$1" fd
  exec {fd}>>"$lock"
  flock -x "$fd"
  printf '%s\n' "$record" >> "$queue"
  flock -u "$fd"
  exec {fd}>&-
}

_queue_log() {
  local file="$1" record="$2" exec_ts fd
  exec_ts=$(date +%s)
  exec {fd}>>"$lock"
  flock -x "$fd"
  printf '%s %s\n' "$exec_ts" "$record" >> "$file"
  flock -u "$fd"
  exec {fd}>&-
}

if (( ! dry_run )); then
  touch "$queue" "$lock" "$inflight"
fi

# Control-command: `-k`/`-K` given with stdin NOT piped (a terminal, or explicitly closed) is
#   not a job submission -- just flips $keepgoing_file for whatever worker owns $session and
#   exits. Lets the user launch a batch in stop-on-error mode, watch it for a while, then
#   switch to unattended once satisfied it's healthy: `tmux-jobs -k -s vcvt`.
if (( ! worker && ! dry_run )) && [[ -t 0 ]]; then
  if ((keepgoing)); then : >| "$keepgoing_file"; else rm -f -- "$keepgoing_file"; fi
  >&2 echo "tmux-jobs: session '$session' keepgoing=$keepgoing"
  exit 0
fi

if (( ! worker && ! dry_run )); then
  if ((${#prog[@]})); then
    while IFS= read -r -d '' arg; do
      [[ -z $arg ]] && continue
      record=''
      printf -v record '%q ' "${prog[@]}"
      printf -v arg '%q' "$arg"
      _queue_append "$record$arg"
    done
  else
    while IFS= read -r -d '' cmd; do
      [[ -z $cmd ]] && continue
      # TODO:OPT:(-c): use shell OR:DFL split execv args by "|" or "<Tab>"
      printf -v record 'bash -xec %q' "$cmd"
      _queue_append "$record"
    done
  fi
  command -v tmux &>/dev/null || { >&2 echo "Err: tmux not found"; exit 2; }
  if ! tmux has-session -t "$session" 2>/dev/null; then
    script=$(realpath -e "$0")
    worker_args=("-j$njobs" "-s$session" "-Q$queue")
    if ((keepgoing)); then worker_args+=(-k); : >| "$keepgoing_file"; else rm -f -- "$keepgoing_file"; fi
    # win_cnt(){ tmux list-windows -t "$nm" 2>/dev/null | wc -l; }
    # -n "$session-$((1+$(win_cnt)))"
    tmux new-session -d -s "$session" -c "$PWD" -- \
      "$script" "${worker_args[@]}" --worker
    tmux set-option -s -t "$session" status on
  fi
  exit 0
fi

if ((dry_run)); then
  printf 'session=%s queue=%s jobs=%s mode=%s\n' "$session" "$queue" "$njobs" "$([[ ${#prog[@]} -gt 0 ]] && echo xargs || echo cmd)"
  if ((${#prog[@]})); then
    while IFS= read -r -d '' item; do
      [[ -z $item ]] && continue
      printf '[dry-run]'
      printf ' %q' "${prog[@]}" "$item"
      printf '\n'
    done
  else
    while IFS= read -r -d '' item; do
      [[ -z $item ]] && continue
      printf '[dry-run] bash -xec %q\n' "$item"
    done
  fi
  exit 0
fi

# _bootstrap_tmux() {
# An existing tmux server can have a different default directory.
# Keep the child in the caller's directory so relative inputs
# such as `.` resolve to the same files after re-exec.
# ALT: set -- "$0" "${_app_orig_argv[@]}"
command -v tmux &>/dev/null || { >&2 echo "Err: tmux not found"; exit 2; }


# DISABLED: this used to be an unconditional bootstrap re-exec
#   (`[[ -n "$TMUX" ]] || exec tmux new-session ...`) from before the
#   queue/worker model existed, meant for a caller running tmux-jobs
#   directly from outside any tmux session. It's obsolete now: every
#   non-worker, non-dry-run invocation already exits earlier via the
#   queue-append-and-launch-worker block above, and a --worker process is
#   always launched already inside its target session
#   (`tmux new-session -d -s "$session" ... --worker`). The old re-exec
#   was reachable ONLY by --worker in current usage -- and firing it there
#   was an active bug: $TMUX is set by the tmux CLIENT on attach, never
#   automatically present in a process spawned into a DETACHED session, so
#   it fired on every worker, dropped -s/-Q/--worker (only -j/prog
#   survive), and re-spawned the worker into a brand-new UNNAMED session,
#   abandoning $session entirely (this is why `tmux has-session -t vcvt`
#   found nothing) without ever reaching the worker loop below (replaced
#   mid-function by exec -- hence a stray mktemp tempfile left over from
#   whatever queue op was in flight, and a queue that never drained).
# [[ -n "${TMUX-}" ]] || exec tmux new-session -c "$PWD" "$0" "-j$njobs" -- "${prog[@]}"

_seq=0

# RENAME? exec_and_monitor_status
# Wraps the real invocation so failure is caught *before* the pane closes,
#   letting us capture pane contents to a log. Runs inside the spawned pane.
# $1 = job id, $2.. = the actual argv to exec (bash -c string, or prog+args)
_wrap() {
  local id="$1" rc=; shift
  "$@" || rc=$?
  printf '%s %s\n' "$id" "$rc" > "$status_dir/$id"
  # Always signal completion via FIFO (worker reads this)
  printf '%s %s\n' "$id" "$rc" > "$events_fifo"
  if ((rc)); then
    # MAYBE:OPT: store log for non-error case too (e.g. for DEBUG script itself)
    local log="./${id}_err_$$.log"
    tmux capture-pane -pt "$TMUX_PANE" -S - > "$log"
    printf '\n\n\033[1;31m[ERROR] Job %s failed (rc=%s)\033[0m\n' "$id" "$rc"
    printf '\033[1;33m[ERROR] Pane output dumped to: %s\033[0m\n' "$log"
    if [[ ! -e $notify_lock ]]; then
      >"$notify_lock" && \
        command -v dunstify &>/dev/null && dunstify -u critical "tmux-jobs: job $id failed (rc=$rc)" ||:
    fi
    if [[ -e $keepgoing_file ]]; then
      printf '\033[1;36m[ERROR] Continuing unattended (-k).\033[0m\n'
    else
      printf '\033[1;36m[ERROR] Press ENTER to close this pane (or run: tmux-jobs -k -s SESSION)...\033[0m\n'
      # Poll instead of blind `read -r`: an unattended/detached worker (--worker, no human
      #   attached to this pane) would otherwise block here forever. Watching $keepgoing_file
      #   lets a live `tmux-jobs -k -s SESSION` control command unstick an ALREADY-blocked
      #   pane, not just prevent future ones from blocking.
      while :; do
        [[ -e $keepgoing_file ]] && { printf '\n[continuing: -k set on session]\n'; break; }
        read -r -t 0.5 && break
      done
    fi
    exit "$rc"
  fi
  ## OLD: Signal completion to the waiter (non-error path too, so dispatch unblocks)
  # tmux wait-for -S "job-done-$id"
}
export -f _wrap

# RENAME? run_job_in_pane()
# Spawns a vertical tmux pane, runs the job, blocks until pane exits
# $1 = job id, $2.. = argv to run via _wrap in a pane
dispatch() { local id="$1" pane_id; shift
  ## ALT: count panes (+1 for --worker) across ALL windows (not just current one)
  # while (( $(tmux list-panes -s -t "$session" | wc -l) >= njobs + 1 ))
  # do sleep 0.5; done
  #
  # Wait for a free slot using wait-for (no polling)
  # We use a counting semaphore via wait-for locks: acquire "slot", release on done
  # tmux wait-for "slot-acquire"  # blocks until a slot is released

  ## ALT: inject function into tmux
  #   pane_id=$(tmux split-window ... -- "$(typeset -f _wrap); _wrap \"$id\"" 2>/dev/null)
  # Try split-window first (stays in current window)
  pane_id=$(tmux split-window -t "$session" -v -P -F "#{pane_id}" -d -- \
    bash -euc 'tmux set-option -p remain-on-exit failed; _wrap "$@"; tmux wait-for -S "slot-release"' _ "$id" "$@" 2>/dev/null) || {
    # If split fails (small screen), create a new window
    pane_id=$(tmux new-window -t "$session" -P -F "#{pane_id}" -- \
      bash -euc 'tmux set-option -p remain-on-exit failed; _wrap "$@"; tmux wait-for -S "slot-release"' _ "$id" "$@" 2>/dev/null) || {
      >&2 echo "Err: split-window and new-window both failed (job $id)"
      tmux wait-for -S "slot-release"  # release the slot we acquired
      return 1
    }
  }

  # FIXME: better name matching cmdline
  tmux select-pane -t "$pane_id" -T "job $id: ${*: -1}" 2>/dev/null ||:

  # pane_run(){ tmux send-keys -t "$nm" "$*" "C-m"; }
  # pane_nm(){ local p=${1:?}; p=${p:0:12}; p=${p/[.:]/_}
  #   pane_run 'printf "\e]2;%s\e\\" '"${p:?}"; }
  # pane_nm "$cmd"
  # pane_run "$cmd"

  tmux select-layout -t "$session" even-vertical 2>/dev/null ||:

  # DONT BLOCK HERE - returns immediately, pane runs in background
  # Completion comes via FIFO

  ## OLD: Block until this specific job signals done (no polling, no sleep)
  ##   before allowing the watcher loop to spawn another one
  # ALT? tmux wait-for -U "$pane_id" 2>/dev/null ||:
  # ALT~ while [[ ! -s $status_dir/$id ]]; do sleep 0.2; done
  # tmux wait-for "job-done-$id"
  #
  # Read exit code (written by _wrap before signaling)
  # read -r _ rc < "$status_dir/$id"
  # tmux kill-pane -t "$pane_id" 2>/dev/null ||:
  # rm -f -- "$status_dir/$id"
  # return "$rc"
}

if ((worker)); then
  exec {rfd}>>"$lock"
  flock -x "$rfd"
  if [[ -s $inflight ]]; then
    cat "$inflight" >> "$queue"
    : >| "$inflight"
  fi
  flock -u "$rfd"
  exec {rfd}>&-

  # Semaphore FIFO (replaces tmux wait-for slot-acquire/slot-release)
  # Write njobs tokens; read one to acquire, write back to release
  sem_fifo="$status_dir/sem.fifo"
  mkfifo "$sem_fifo"
  exec {sem_fd}<>"$sem_fifo"
  rm -f "$sem_fifo"

  ## BAD: hardcoded -j, will be hard to make it dynamic based on queue "thread weights"
  # Prime the semaphore with njobs slots
  for ((i=0; i<njobs; i++)); do
    printf 'x\n' >&"$sem_fd"
  done

  ## BET?MOVE: events fifo into ~/.cache/tmux/<session>.fifo
  # Event FIFO for job completions
  events_fifo="$status_dir/events.fifo"
  mkfifo "$events_fifo"
  export events_fifo
  # Keep FIFO open for reading (prevents EOF when last writer closes)
  exec {fifo_fd}<>"$events_fifo"
  rm -f "$events_fifo"  # unlink, fd keeps it alive

  declare -A worker_record=()
  declare -A worker_job=()
  running=0

  _start_queued() {
    local record added_ts command job
    while ((running < njobs)); do
      _queue_take_first
      [[ -n $record ]] || break
      added_ts=${record%% *}
      command=${record#* }
      _seq=$((_seq + 1))
      job=$_seq
      # Acquire slot (blocks interruptibly)
      IFS= read -r _ <&"$sem_fd" || return 1
      dispatch "$job" bash -xec "$command"
      worker_record[$job]=$record
      worker_job[$job]=$job
      running=$((running + 1))
    done
  }

  _start_queued

  ## WARN: killing worker on <C-c> doesn't kill panes
  # _cleanup() {
  #   for pid in "${child_pids[@]}"; do
  #     kill -TERM "$pid" 2>/dev/null ||:
  #   done
  #   # Also kill any tmux panes we spawned
  #   tmux list-panes -t "$session" -F "#{pane_id} #{pane_title}" 2>/dev/null | \
  #     awk '/^job / {print $1}' | xargs -r tmux kill-pane -t 2>/dev/null ||:
  #   exit 130
  # }
  # trap _cleanup INT TERM

  # Main loop: read completions from FIFO
  while ((running > 0)); do

    IFS= read -r job rc <&"$fifo_fd"
    [[ -n $job ]] || continue
    record=${worker_record[$job]}
    unset 'worker_record[$job]' 'worker_job[$job]'
    running=$((running - 1))
    # Release slot
    printf 'x\n' >&"$sem_fd"

    if ((rc == 0)); then
      _queue_log "$success_log" "$record"
      _inflight_remove "$record"
    else
      _queue_log "$failure_log" "$record"
      _inflight_remove "$record"
      if [[ -e $keepgoing_file ]]; then
        :
      else
        _queue_requeue "$record"
        >&2 echo "Err: queued job failed; retained in $queue"
        # Drain remaining jobs
        while ((running > 0)); do
          IFS= read -r job rc <&"$fifo_fd"
          record=${worker_record[$job]}
          unset 'worker_record[$job]' 'worker_job[$job]'
          running=$((running - 1))
          printf 'x\n' >&"$sem_fd"
          ((rc == 0)) && _queue_log "$success_log" "$record" || _queue_log "$failure_log" "$record"
          _inflight_remove "$record"
        done
        break
      fi
    fi
    _start_queued
  done

  exec {fifo_fd}<&-
  exec {sem_fd}<&-
elif ((${#prog[@]})); then
  # xargs-mode: each stdin record is one arg, appended to the fixed prog+args.
  while IFS= read -r -d '' arg; do
    [[ -z $arg ]] && continue
    _seq=$((_seq + 1))
    dispatch "$_seq" "${prog[@]}" "$arg"
  done
else
  # cmd-mode: each stdin record is a full command string, run under bash -xec.
  while IFS= read -r -d '' cmd; do
    [[ -z $cmd ]] && continue
    _seq=$((_seq + 1))
    dispatch "$_seq" bash -xec "$cmd"
  done
fi

if command -v dunstify &>/dev/null; then
  if [[ -e $notify_lock ]]; then
    dunstify -u critical "tmux-jobs: jobs finished with failures"
  else
    dunstify "tmux-jobs: all jobs finished"
  fi
fi
rm -f -- "$notify_lock"
rmdir "$status_dir" 2>/dev/null ||:
