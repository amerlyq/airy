#!/usr/bin/env bash
# DEBUG: $ ffprobe input.mp4
# USAGE:(watcher): $ tmux new-session -s cvt && vcvt -w
# USAGE: $ print -l {22..30} |xargs -t -n1 -P0 sh -c 'time /b/vcvt -c"$0" input.mp4 &>"$0".log'
# USAGE:(batch panes): $ vcvt -b a.mp4 b.mp4 c.mp4
# USAGE:(batch panes from stdin): $ find . -name '*.mp4' -not -name '*_[acnqv][0-9][0-9].mp4' | vcvt -b

set -o errexit -o errtrace -o functrace -o noclobber -o noglob -o nounset -o pipefail
shopt -qs inherit_errexit lastpipe

njobs=4  # workers=(1..4) x16 threads per each AV1


while LC_COLLATE=C getopts 'ac:bgwx-:' o; do
case $o in :|'?') exit 2
;; a) ifx=a
;; b) batch=1
;; c) qa=$OPTARG
;; g) gpu=1
# ;; s) byserver=1
;; w) watch=1
;; x) set -x && xt=${-//[^x]}
esac; done; flags=("${@:1:OPTIND-1}"); shift $((OPTIND-1)); unset o

# NOTE: find -H with a missing path silently emits nothing for that path
#   and continues with the rest. No error, no non-zero exit. So pre-checking
#   with [[ -e ]] is the only way to surface "Err: not found: ..." cleanly.
#   Verified:
#     $ printf 'exists/\nmissing/\n' | find -H - -type f -name '*.mp4' -print
#     exists/a.mp4
#     $ echo $?
#     0
#   Directories are expanded recursively to non-AV1 mp4 files
#   Files are passed through as-is (must exist)
_collect_paths() {
  # Reads stdin (one path per line), echoes \0-separated existing paths
  local f
  while IFS= read -r f || [[ -n $f ]]; do
    [[ -z $f ]] && continue
    [[ -e $f ]] || { >&2 echo "Err: not found: $f"; return 1; }
    printf '%s\0' "$f"
  done
}

_expand_to_mp4s() {
  # Reads \0-separated paths on stdin, emits \0-separated existing mp4 files
  # (recursively expanded if a path is a directory). Paths that don't exist
  # are reported on stderr and cause a non-zero exit.
  #
  # NOTE: `find -H` silently skips missing paths (no error, exit 0). To surface
  #   typos/missing args cleanly, we pre-validate with [[ -e ]] before passing
  #   anything to find. Without this, `vcvt bad.mp4 good.mp4` would silently
  #   process only good.mp4 with no indication that bad.mp4 was dropped.
  local p
  while IFS= read -r -d '' p; do
    [[ -e $p ]] || { >&2 echo "Err: not found: $p"; return 1; }
    [[ -r $p || -d $p ]] || { >&2 echo "Err: not readable: $p"; return 1; }
    printf '%s\0' "$p"
  done | find -H -type f -name '*.mp4' -print0
}

_filter_non_av1() {
  # Reads \0-separated mp4 paths, emits \0-separated non-AV1 ones.
  xargs -0r -P4 -L10 mediainfo --Inform="General;%Video_Codec_List% %CompleteName%\n" -- \
    | awk -vC="AV1" 'NF&&$1!=C{print substr($0,index($0," ")+1)}'
}

input_files=()
if (($#)); then
  # NOTE: lastpipe + inherit_errexit (set at top) lets this while loop run in
  #   the current shell, so errors from _expand_to_mp4s / _filter_non_av1
  #   propagate. Using <(...) would swallow their exit status.
  for f in "$@"; do printf '%s\0' "$f"; done \
    | _expand_to_mp4s \
    | _filter_non_av1 \
    | while IFS= read -r -d '' f; do
        input_files+=("$f")
      done
elif [[ ! -t 0 ]]; then
  # Stream-mode stdin path: dispatch each resolved mp4 immediately. We avoid
  #   buffering into input_files here because that would block on EOF before
  #   any conversion runs. For batch mode (finite stdin list), the downstream
  #   -b handler iterates synchronously; for streaming watcher use, the
  #   stdin-watcher branch below handles dispatch directly.
  _collect_paths \
    | _expand_to_mp4s \
    | _filter_non_av1 \
    | while IFS= read -r -d '' f; do
        input_files+=("$f")
      done
fi
((${batch:-0} + ${watch:-0} > 1)) && { >&2 echo "Err: -b and -w are mutually exclusive"; exit 2; }

# If a path was supplied (args or stdin) but produced no non-AV1 mp4 files,
#   exit cleanly here. Otherwise the script falls through to the single-file
#   conversion path below with `fin=$1` still set to the original arg (e.g.
#   a directory like `.`), and ffmpeg errors out with "Is a directory".
if (($#)) || [[ ! -t 0 ]]; then
  if ((!${batch:-0} && !${watch:-0})); then
    if ((${#input_files[@]} == 0)); then
      >&2 echo "Err: no non-AV1 mp4 files found in input"
      exit 2
    fi
    # Single-file mode: pick the first resolved file and run the ffmpeg
    # pipeline directly. This replaces the original `fin=$1` behavior so
    # directory args get expanded correctly.
    set -- "${input_files[0]}"
  fi
fi


# ─────────────────────────────────────────────────────────
# tmux-aware worker: runs conversion in its own pane
# On failure, pane contents are captured to <file>_err_<pid>.log
# ─────────────────────────────────────────────────────────
exec_and_monitor_status() {
  local file="$1" rc=
  bash -xec '
    echo "[convert] $0"
    vcvt "$0"
    mv -vt ../done/ -- "$0" "${0%.*}_"[acnqv][0-9][0-9]".${0##*.}"
    echo "---"
  ' "$file" || rc=$?
  if ((rc)); then
    mkdir -p ../done
    local log_path
    log_path="../done/$(basename "${file%.*}")_err_$$.log"
    tmux capture-pane -pt "$TMUX_PANE" -S - > "$log_path"
    printf '\n\n\033[1;31m[ERROR] Conversion failed!\033[0m\n'
    printf '\033[1;33m[ERROR] Pane output dumped to: %s\033[0m\n' "$log_path"
    # TEMP:
    printf '\033[1;36m[ERROR] Press ENTER to close this pane...\033[0m\n'
    read -r
    exit "$rc"
  fi
}
export -f exec_and_monitor_status

# Spawns a vertical tmux pane, runs the job, blocks until pane exits
run_job_in_pane() {
  local file="$1" pane_id

  # Limit concurrent panes across ALL windows (not just current one)
  #   tmux list-panes -a counts panes in every window; +1 for the
  #   controlling shell pane that runs the watcher loop.
  while (( $(tmux list-panes -a | wc -l) >= njobs + 1 )); do
    sleep 0.5
  done

  # Try split-window first (stays in current window)
  pane_id=$(tmux split-window -v -P -F "#{pane_id}" -d -- "
    $(typeset -f exec_and_monitor_status)
    exec_and_monitor_status \"$file\"
  " 2>/dev/null) || {
    # If split fails (small screen), create a new window
    pane_id=$(tmux new-window -P -F "#{pane_id}" -- "
      $(typeset -f exec_and_monitor_status)
      exec_and_monitor_status \"$file\"
    " 2>/dev/null) || {
      echo "[tmux] split-window and new-window both failed for: $file" >&2
      return 1
    }
  }
  tmux select-layout even-vertical 2>/dev/null ||:

  # BLOCK: wait for this pane to exit before allowing the watcher loop
  #   to spawn another one. Without this, the loop fires off njobs
  #   panes immediately, then keeps stacking more ("spawns +4 panels
  #   per each new window too").
  tmux wait-for -U "$pane_id" 2>/dev/null ||:
}
export -f run_job_in_pane

# ALT: no-tmux fallback worker
run_job_local() {
  echo "[convert] $1"
  # ALT:(&pg): vcvt ... 2>&1 | pv -N "$(basename "$0" | cut -c1-15)" -l -q > /dev/null
  vcvt "$1"
  mv -vt ../done/ -- "$1" "${1%.*}_"[acnqv][0-9][0-9]".${1##*.}"
  echo "---"
}
export -f run_job_local

# Re-exec self into a fresh tmux session if not already inside one.
# Callers (watch / batch / stdin-watcher) all need the same bootstrap.
_bootstrap_tmux() {
  command -v tmux &>/dev/null || { echo "Err: run inside tmux" >&2; exit 2; }
  [[ -z "${TMUX-}" ]] && exec tmux new-session "$0" "${flags[@]}" --
}

if [[ -z ${gpu:+x} ]]; then
  # declare use=cpu qa=32 ifx=va
  : ${use:=cpu} ${qa:=32} ${ifx:=v}
elif [[ -e /dev/nvidia0 ]]; then
  : ${use:=nv} ${qa:=28} ${ifx:=n}
elif [[ -d /sys/module/i915 ]] || [[ -d /sys/module/xe ]]; then
  # REF:(qa): https://www.ffmpeg.org/ffmpeg-codecs.html#Ratecontrol-Method
  #   For the ICQ modes, global quality range is 1 to 51, with 1 being the best quality.
  : ${use:=nv} ${qa:=28} ${ifx:=n}
else >&2 echo "MAYBE: Fallback to Software Encoding"; exit 1; fi


# ─────────────────────────────────────────────────────────
# -w : inotify-based watcher
# ─────────────────────────────────────────────────────────
if [[ ${watch-} ]]; then
  set -x
  cd "${1:-/cache/vd_cvt/todo}"  # RENAME? ./watch
  echo "Watching: $PWD"

  _bootstrap_tmux

  # inotify pipeline: emits paths as they're close_write'd in $PWD.
  # `-w` owns its input source (the watched dir); stdin is not consumed
  # here -- the stdin-watcher path is the alternative for piped input.
  inotify_src() {
    find ../queue -regextype egrep -type f -name '*.mp4' \
      -not -regex '.*_(va|[acnqv])[0-9]{2}\.mp4$' -print
    inotifywait -m -e close_write --format '%f' . | while read -r f; do
      [[ ${f:0:1} == "." ]] && continue  # <CASE: skip rsync temp files
      echo "[detected] $f"
      mv -vt ../queue/ -- "./$f"
      realpath -e "../queue/$f"
    done
  }

  inotify_src | while read -r f; do
    run_job_in_pane "$f"
  done
  exit
fi

# ─────────────────────────────────────────────────────────
# stdin-watcher: when invoked with no args and stdin is a pipe,
#   read paths forever and dispatch each to a tmux pane.
#   External watcher app pipes paths; we spawn a cvt job per line.
# ─────────────────────────────────────────────────────────
if [[ ! -t 0 ]] && (($# == 0)); then
  _bootstrap_tmux

  # Stream stdin: each line is a path (file or dir). Reuse the same
  # find+mediainfo AV1 filter as the batch path, then dispatch each
  # resulting mp4 to a tmux pane as soon as it appears.
  while IFS= read -r f || [[ -n $f ]]; do
    [[ -z $f ]] && continue
    printf '%s\0' "$f"
  done | _expand_to_mp4s | _filter_non_av1 | while IFS= read -r -d '' mp4; do
    [[ -f $mp4 ]] && run_job_in_pane "$mp4"
  done
  exit
fi

# ─────────────────────────────────────────────────────────
# -b : batch mode -- dispatch resolved input list to tmux panes
# ─────────────────────────────────────────────────────────
if [[ ${batch-} ]]; then
((${#input_files[@]} == 0)) && { >&2 echo "Err: -b requires files as args or stdin"; exit 2; }
  set -x

  if command -v tmux &>/dev/null; then
    _bootstrap_tmux
    runner=run_job_in_pane
  else
    runner=run_job_local
  fi
  echo "Batch: $PWD (${#input_files[@]} files -> $runner)"
  for f in "${input_files[@]}"; do
    "$runner" "$f"
  done
  exit
fi

