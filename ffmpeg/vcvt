#!/usr/bin/env bash
# DEBUG: $ ffprobe input.mp4
#%USAGE:
#   [single_file]:     $ vcvt input.mp4
#   [multiple/batch]:  $ vcvt a.mp4 b.mp4 c.mp4
#   [dir_recursive]:   $ vcvt ./some_dir/
#   [stdin_list]:      $ find . -name '*.mp4' -not -name '*_[acnqv][0-9][0-9].mp4' | vcvt
#   [watch_dir]:       $ [tmux new-session -s cvt &&] vcvt -w /cache/vd_cvt/todo
#   [serial_no-tmux]:  $ vcvt -j1 *.mp4
#   [parallel_tmux]:   $ vcvt -j4 *.mp4
#   [codec_dashboard]: $ print -l {22..30} |xargs -t -n1 -P4 sh -c 'time vcvt -c"$0" input.mp4 &>"$0".log'
#
# Resolves input to a list of non-AV1 mp4 files, then:
#   - exactly one file  -> converts it in-process, no tmux/queue at all
#   - more than one file, or -w watch arrivals -> enqueues via !tmux-jobs
#     = persistent queue (append-and-exit)
#     = a detached "vcvt" tmux session drains it
#       : it spawns `vcvt <passthrough flags> FILE` per file in its own pane
#     = `tmux attach -t vcvt` from elsewhere shows progress.
#     = njobs should be decided based on codec-specific thread usage TEMP: same for whole session
#
# TODO:ENH: optimal "-jN" may differ between different tasks sharing one
#     queue/session (e.g. GPU vs CPU jobs enqueued together)
#     FUT:IDEA: store in queue how many CPU threads each job needs, and
#       take as many jobs as fit into total CPU budget -- e.g. instead of
#       flat -j4 x16 for AV1, mark each job as needing 16 threads out of a
#       64-core budget and let the worker pack jobs to fit

set -o errexit -o errtrace -o functrace -o noclobber -o noglob -o nounset -o pipefail
shopt -qs inherit_errexit lastpipe
PS4='+[$BASHPID] ${BASH_SOURCE[0]##*/}:$LINENO:  '

njobs=4  # workers=(1..4) x16 threads per each AV1

readonly _app_orig_argv=("$@")
while LC_COLLATE=C getopts 'Aac:gij:wxD' o; do
case $o in :|'?') exit 2
;; A) tmux attach -t "vcvt"
;; a) ifx=a               #: -a    : force ifx=a (infix tag override)
;; c) qa=$OPTARG          #: -c QA : quality (crf/cq/global_quality, encoder-dependent)
;; D) archive=1           #: -D    : archive fin+out to ../done/ after a successful convert
;; i) inprocess=1         #: -i    : convert files w/o tmux one-by-one ("individual/isolated/inplace")
;; g) gpu=1               #: -g    : prefer GPU encode (nvenc/qsv) over cpu (svt-av1)
;; j) forcejobs=$OPTARG   #: -j N  : concurrency, "1" skips tmux; DFL=0 : auto (sized from codec below)
# ;; s) byserver=1
;; w) watch=1             #: -w DIR: watch mode (implies -D), owns ./{todo,queue,done} directory layout
;; x) set -x              #: -x    : set -x tracing, forwarded to per-file re-invocations
esac; done; flags=("${@:1:OPTIND-1}"); shift $((OPTIND-1)); unset o
xt=${-//[^x]}

: "${use:=}" "${qa:=}" "${ifx:=v}"
if [[ -z ${gpu:+x} ]]; then
  # declare use=cpu qa=32 ifx=va
  : ${use:=cpu} ${qa:=32} ${ifx:=v}
elif [[ -e /dev/nvidia0 ]]; then
  # OR: [[ -e /etc/bumblebee/bumblebee.conf ]] && ffmpeg=(optirun "${ffmpeg[@]}")
  : ${use:=nv} ${qa:=28} ${ifx:=n}  # PC with Dedicated NVIDIA (Always active, no integrated graphics)
elif [[ -d /sys/module/i915 ]] || [[ -d /sys/module/xe ]]; then
  # elif [ -d /sys/class/drm/card0/device/intel-guc ] || [ -e /dev/dri/by-path/*-pci-*-intel-* ]
  # REF:(qa): https://www.ffmpeg.org/ffmpeg-codecs.html#Ratecontrol-Method
  #   For the ICQ modes, global quality range is 1 to 51, with 1 being the best quality.
  : ${use:=nv} ${qa:=28} ${ifx:=n}  # Laptop with Intel QSV (Intel driver loaded, no active NVIDIA)
else
  >&2 echo "Err: no GPU encode path found (no nvidia/i915/xe)"
  exit 1  # <MAYBE: Fallback to Software Encoding
fi
readonly use qa ifx

# Codec-specific concurrency: svt-av1 (cpu) is heavily multithreaded per job
#   (~16 threads/job), so only a handful of jobs should run at once even on
#   a big machine. nvenc/qsv have their own session caps (~3-12) but are far
#   less per-job-thread-hungry, so allow more concurrent dispatch.
_auto_njobs() { local nproc_n
  nproc_n=$(nproc 2>/dev/null || echo 4)
  case $use
  in cpu) echo $(( nproc_n / 16 > 0 ? nproc_n / 16 : 1 ))
  ;; nv) echo 5
  ;; qsv) echo 1
  ;; *) echo 1
  esac
}
if [[ -n ${forcejobs-} ]]; then
  njobs=$forcejobs
else
  njobs=$(_auto_njobs)
fi

# ── input resolution ─────────────────────────────────────────────────
# NOTE: find -H with a missing path silently emits nothing for that path
#   and continues with the rest. No error, no non-zero exit. So pre-checking
#   with [[ -e ]] is the only way to surface "Err: not found: ..." cleanly.
# DEBUG: $ printf 'exists/\nmissing/\n' | find -H - -type f -name '*.mp4' -print; echo $?
collect_paths() { local f
  while IFS= read -r f || [[ -n $f ]]; do
    [[ -z $f ]] && continue
    # REMOVE? we verify it below AGAIN anyway
    [[ -e $f ]] || { >&2 echo "Err: not found: $f"; return 1; }
    printf '%s\0' "$f"
  done
}

# RQ:(--files0-from):DEP: !findutils>=4.9
#   ALT:BUG:(<4.9): `find -H` silently ignores stdin and scans $PWD instead
_expand_to_mp4s() { local p
  while IFS= read -r -d '' p; do
    [[ -e $p ]] || { >&2 echo "Err: not found: $p"; return 1; }
    [[ -r $p || -d $p ]] || { >&2 echo "Err: not readable: $p"; return 1; }
    printf '%s\0' "$p"
  # Include symlinked files explicitly. Do not use realpath: ffmpeg must see
  # the submitted symlink path so its output is created beside the symlink.
  # MAYBE: use "-xtype f"
  done | find -H -files0-from - -maxdepth 1 \( -type f -o -type l \) -iname '*.mp4' -print0
}

_filter_non_av1() {
  # BUG(fixed): mawk's printf "\0" does NOT emit a literal NUL byte (silently
  #   dropped) -- only gawk supports that. Portable fix: ORS="\0" with plain
  #   print, which mawk handles correctly.
  xargs -0r -P4 -L10 mediainfo --Inform="General;%Video_Codec_List% %CompleteName%\n" -- \
    | awk -vC="AV1" 'BEGIN{ORS="\0"} NF&&$1!=C{print substr($0,index($0," ")+1)}'
}

# ─────────────────────────────────────────────────────────
# Single-file conversion (in-process, real argv, no shell-string layer)
# ─────────────────────────────────────────────────────────

_cvt_nv() { local fin="$1" out="$2"
  local nvopts=(  # <CASE:(amv):
    -preset p7 -highbitdepth 1 -multipass qres
    -rc vbr -cq "$qa" -maxrate 8M -bufsize 16M
    -rc-lookahead 48 -lookahead_level auto
    -spatial_aq 1 -aq-strength 8 -g 30 -bf 4 -b_ref_mode middle
  )
  local vf_scale="scale_cuda=w='trunc(iw*min(1,min(if(gt(iw,ih),1920,1080)/iw,if(gt(iw,ih),1080,1920)/ih))/2)*2':h='trunc(ih*min(1,min(if(gt(iw,ih),1920,1080)/iw,if(gt(iw,ih),1080,1920)/ih))/2)*2':format=yuv420p"
  "${ffmpeg[@]:-ffmpeg}" -hwaccel cuda -hwaccel_output_format cuda \
    -i "$fin" -vf "$vf_scale" \
    -c:v hevc_nvenc "${nvopts[@]}" -c:a copy "$out"
}

_cvt_qsv() { local fin="$1" out="$2"
  local vf_scale="scale_qsv=w='trunc(iw*min(1,min(if(gt(iw,ih),1920,1080)/iw,if(gt(iw,ih),1080,1920)/ih))/2)*2':h='trunc(ih*min(1,min(if(gt(iw,ih),1920,1080)/iw,if(gt(iw,ih),1080,1920)/ih))/2)*2',format=qsv"
  ## ALT:(qsv variants): -c:v h264_qsv|av1_qsv|hevc_qsv OR:(auto): -init_hw_device qsv=qsv:hw
  # BAD: no "-tune animation" -- only for software-render
  "${ffmpeg[@]:-ffmpeg}" -init_hw_device qsv=qsv:hw -hwaccel qsv -hwaccel_output_format qsv \
    -i "$fin" -vf "$vf_scale" \
    -c:v hevc_qsv -preset slow -global_quality "$qa" "$out"
}

_cvt_cpu() { local fin="$1" out="$2"
  local cpuopts=(  # <CASE:(amv/cg):
    -preset 4 -crf "$qa" -pix_fmt yuv420p10le
    -svtav1-params "tune=1:scd=1:keyint=5s:lookahead=120:enable-qm=1:qm-min=0:qm-max=15:enable-overlays=1:sharpness=1"
  )
  local vf_scale="scale=w='if(gt(iw,ih),min(iw,1920),min(iw,1080))':h='if(gt(iw,ih),min(ih,1080),min(ih,1920))':force_original_aspect_ratio=decrease:force_divisible_by=2:flags=lanczos,format=yuv420p10le"
  "${ffmpeg[@]:-ffmpeg}" \
    -i "$fin" -vf "$vf_scale" \
    -c:v libsvtav1 "${cpuopts[@]}" -c:a copy "$out"
}

_convert_one() { local fin="$1"
  local out="${fin%.*}_${ifx}${qa}.${fin##*.}"
  local ffmpeg=(ffmpeg -hide_banner)  # -v error | -v verbose
  # MAYBE: ffmpeg+=(-y)

  if [[ -e $out ]]; then
    # FIXME: use mtime inof RANDOM for deterministic sorting of old variants in !ranger ?
    mv -vfT --backup=t -- "$out" "${out%.*}_prev${RANDOM}.${out##*.}"
  fi

  echo "_cvt_$use" "$fin" "$out"
  sleep 5

  if [[ ${archive-} || ${watch-} ]]; then
    mkdir -p ../done
    mv -vt ../done/ -- "$fin" "$out"
  fi
}

# Flags to forward when re-invoking vcvt per-file for parallel dispatch.
# Mirrors what was parsed above; -j is deliberately NOT forwarded (each
#   per-file worker is a single-file call, no further fan-out needed).
_passthrough_flags() {
  local -a f=()
  [[ ${ifx-} == a ]] && f+=(-a)
  [[ -n ${qa-} ]] && f+=(-c "$qa")
  [[ ${gpu-} ]] && f+=(-g)
  [[ ${archive-} ]] && f+=(-D)
  [[ $- == *x* ]] && f+=(-x)
  printf '%s\0' "${f[@]}"
}

# Hands a NUL-sep file list off to tmux-jobs' persistent queue and returns
#   immediately (append-and-exit) -- this IS the fan-out path for every
#   multi-file case, batch or watch. njobs still governs how many of these
#   run concurrently once picked up by the (possibly-already-running)
#   worker session; it does not decide whether the queue is used at all.
#   (Resolved TODO:FIXME:duplication -- this replaces two near-identical
#   inline blocks that used to live in _dispatch and the watch loop.)
_enqueue() {
  # ALSO: print filename if $#==1
  echo "Batch ($# files -> !tmux-jobs) in [PWD=$PWD]"
  command -v tmux-jobs &>/dev/null || { >&2 echo "Err: tmux-jobs not found on PATH"; exit 2; }
  local -a flags=()
  while IFS= read -r -d '' a; do flags+=("$a"); done < <(_passthrough_flags)
  # "$@" = files to enqueue (NUL-sep list is read by the caller into an array
  #   and passed here as positional args, so this can be called with either
  #   one file (watch-mode arrivals) or many (batch) uniformly).
  printf '%s\0' "$@" | exec tmux-jobs ${xt:+-x} -j"$njobs" -s vcvt -- vcvt "${flags[@]}"
}

# Dispatches a NUL-sep file list on stdin: single file converts in-process
#   (no tmux/queue involved -- this is the one case with nothing to fan out),
#   multiple files always enqueue via tmux-jobs (append-and-exit).
_dispatch() {
  local -a files=()
  # Batch mode intentionally consumes stdin to EOF.
  #   FAIL? convertion is blocked till EOF from *streaming external watcher*
  readarray -d '' -t files
  ((${#files[@]})) || { >&2 echo "Err: no non-AV1 mp4 files found in input"; exit 2; }

  if [[ -z ${inprocess:+x} ]]; then
    # DISABLED:FAIL: tmux mess doesn't work yet
    _enqueue "${files[@]}"
  elif ((${#files[@]} <= 1)); then
    _convert_one "${files[0]}"
  else
    echo "Batch (${#files[@]} files -> one-by-one) in [PWD=$PWD]"
    local f; for f in "${files[@]}"; do
      echo "[convert] $f"
      # ALT:(&pg): vcvt ... 2>&1 | pv -N "$(basename "$0" | cut -c1-15)" -l -q > /dev/null
      _convert_one "$f"
      ## ALT:MAYBE: do this to move files after failed/interrupted conversion?
      # mv -vt ../done/ -- "$1" "${1%.*}_"[acnqv][0-9][0-9]".${1##*.}"
      echo "---"
    done
  fi
}

# ── modes ────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────
# -w : inotify-based watcher
# ─────────────────────────────────────────────────────────
if [[ ${watch-} ]]; then
  dir=${1:-/cache/vd_cvt/todo}  # RENAME? ./watch
  [[ -d $dir ]] || { >&2 echo "Err: watch dir not found: $dir"; exit 2; }
  cd "$dir"
  >&2 echo "Watching: $PWD"
  archive=1  # watch mode always archives to ../done/

  # Emits queued mp4 paths as they arrive (existing backlog first, then
  #   inotify for close_write()), moving each into ../queue/ before emitting
  #   -- this is watch-mode's own bookkeeping, orthogonal to job execution.
  _inotify_src() {
    find ../queue -regextype egrep -type f -name '*.mp4' \
      -not -regex '.*_(va|[acnqv])[0-9]{2}\.mp4$' -print0
    inotifywait -m -e close_write --format '%f' . | while read -r f; do
      [[ ${f:0:1} == "." ]] && continue  # <CASE: skip rsync temp files
      >&2 echo "[detected] $f"
      mv -vt ../queue/ -- "./$f"
      printf '%s\0' "../queue/$f"
    done
  }

  # RESOLVED FAIL: every arrival now enqueues via tmux-jobs (append-and-exit,
  #   near-instant) instead of running _convert_one inline -- the inotify
  #   reader is no longer blocked for the duration of a conversion, however
  #   long. This holds regardless of njobs: njobs governs the worker
  #   session's own concurrency, not whether THIS loop blocks.
  #   (njobs=0/auto is a sizing default for the worker, never a signal to
  #   skip the queue -- resolved the "njobs=0 implies multiple jobs" FAIL by
  #   no longer branching on njobs here at all.)
  _inotify_src | while IFS= read -r -d '' f; do
    [[ -f $f ]] || continue  # <REMOVE? events should be existing files OR it should be error, not silent skipping
    _enqueue "$f"
  done
  exit
fi

# Args come from "$@"; empty $# means read paths from stdin.
# Emits NUL-separated non-AV1 mp4 paths on stdout.
{ (($#)) && printf '%s\0' "$@" || collect_paths
} | _expand_to_mp4s | _filter_non_av1 | _dispatch


